# Chave do openrouteservice, usada APENAS no servidor:
ORS_API_KEY=
# Photon demo: uso leve/desenvolvimento. Para produção, usar instância própria ou contratada:
PHOTON_BASE_URL=https://photon.komoot.io
# A URL e a chave publishable são públicas. NUNCA expor a service_role:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps + Places (New): activate ONLY after both keys and billing are configured.
NEXT_PUBLIC_MAP_PROVIDER=photon
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
